{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "react-hooks", "import", "jsx-a11y", "unicorn"],
  "categories": { "correctness": "error", "perf": "warn", "suspicious": "warn", "pedantic": "off" },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "env": { "browser": true, "es2024": true, "node": true },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "public",
    "src/lib/api/generated",
    "src/components/ui",
    "src/stories",
    ".storybook"
  ]
}
